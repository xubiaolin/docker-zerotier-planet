DOCKER_IMAGE=xubiaolin/zerotier-planet:latest
CONTAINER_NAME=myztplanet
DATA_DIR=./data/zerotier

ZEROTIER_VERSION=1.16.2
ZTNCUI_COMMIT=1b2284864de48d2dcae22582fff122fe24909c3d

ZT_PORT=9994
API_PORT=3443
FILE_SERVER_PORT=3000

# Leave empty to let the container discover the public address on first start.
IP_ADDR4=
IP_ADDR6=

# Optional. When empty, a random password is generated for a new installation.
ZTNCUI_ADMIN_PASSWORD=
