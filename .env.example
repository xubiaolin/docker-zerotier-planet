# Copy this file to .env and edit the values before starting.
#
# Generate FILE_KEY with:
#   openssl rand -hex 32

DOCKER_IMAGE=xubiaolin/zerotier-planet:latest

# Public addresses written into the generated planet/moon files.
# IP_ADDR6 may be left empty when the server has no public IPv6.
IP_ADDR4=YOUR_PUBLIC_IPV4
IP_ADDR6=

# Publicly exposed service ports.
ZT_PORT=9994
API_PORT=3443
FILE_SERVER_PORT=3000

# Required download key for the planet/moon file server.
FILE_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Persistent host data directories.
ZEROTIER_DIST_DIR=./data/zerotier/dist
ZEROTIER_ZTNCUI_DIR=./data/zerotier/ztncui
ZEROTIER_ONE_DIR=./data/zerotier/one
ZEROTIER_CONFIG_DIR=./data/zerotier/config
